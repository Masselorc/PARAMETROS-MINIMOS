# Arquivos temporários do Microsoft Office / Excel
~$*.xlsx
~$*.xls
~$*.xlsm
*.tmp

# Arquivos do sistema operacional
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Ambientes virtuais e dependências
.env
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Lock local do Excel (runtime)
.dados.lock

# Arquivos operacionais gerados localmente (não versionar).
# DADOS.xlsx é a fonte principal e permanece versionado; só o temporário é ignorado.
ANEXOS/
BACKUPS/
EXPORTACOES/
DADOS_tmp_validacao.xlsx

# Especificação do sistema (documento interno de trabalho)
ESPECIFICACAO_SISTEMA_PARAMETROS_MINIMOS.md

# Orquestração interna de agentes (transiente, nunca versionar)
.agents/
